# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear el .env con valores reales

# ID del form en formspree.io (crear en https://formspree.io/forms)
PUBLIC_FORMSPREE_ID=YOUR_FORM_ID

# Claude API Key para el chatbot (en https://console.anthropic.com)
# Solo necesaria para el Cloudflare Worker del chatbot
CLAUDE_API_KEY=sk-ant-...

# Dominio de Cloudflare Pages (se completa al hacer deploy)
# Ejemplo: induccion-ameec.pages.dev
CLOUDFLARE_PAGES_URL=
