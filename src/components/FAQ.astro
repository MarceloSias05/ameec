---
import faqData from '../content/induccion/faq.json';

const preguntas = faqData.items;
---

<section id="faq" class="bg-white py-20 md:py-28">
  <div class="container-narrow">
    <div class="mb-16 max-w-2xl">
      <p class="eyebrow mb-3">Preguntas frecuentes</p>
      <h2 class="font-display text-4xl font-bold leading-tight text-verde-500 md:text-5xl">
        Todo lo que quieres saber antes de inscribirte
      </h2>
    </div>

    <dl class="max-w-3xl space-y-4">
      {
        preguntas.map((item, i) => (
          <div
            class="group overflow-hidden rounded-2xl border border-carbon/10 bg-crema"
            x-data="{ open: false }"
          >
            <dt>
              <button
                class="flex w-full items-center justify-between px-7 py-5 text-left font-medium text-carbon transition-colors hover:text-verde-500"
                aria-expanded="false"
                data-faq-toggle
                data-faq-index={i}
              >
                <span class="pr-4">{item.pregunta}</span>
                <svg
                  class="h-5 w-5 shrink-0 text-ocre-400 transition-transform duration-200"
                  data-faq-icon
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 3a.75.75 0 01.75.75v10.5a.75.75 0 01-1.5 0V3.75A.75.75 0 0110 3zm-3.97 3.22a.75.75 0 011.06 0L10 9.19l2.91-2.97a.75.75 0 111.08 1.06l-3.46 3.53a.75.75 0 01-1.08 0L6.03 7.28a.75.75 0 010-1.06z"
                    clip-rule="evenodd"
                  />
                </svg>
              </button>
            </dt>
            <dd class="hidden px-7 pb-5 leading-relaxed text-carbon/75" data-faq-answer>
              {item.respuesta}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  document.querySelectorAll('[data-faq-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const answer = btn.parentElement?.nextElementSibling as HTMLElement | null;
      const icon = btn.querySelector('[data-faq-icon]') as HTMLElement | null;

      btn.setAttribute('aria-expanded', String(!isExpanded));

      if (answer) {
        answer.classList.toggle('hidden', isExpanded);
      }
      if (icon) {
        icon.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(180deg)';
      }
    });
  });
</script>
