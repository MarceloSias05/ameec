---
import general from '../content/config/general.json';

const links = {
  ecosistema: [
    { href: 'https://ameec.org', label: 'ameec.org' },
    { href: '/proyectos/olas-de-amor', label: 'Olas de Amor' },
    { href: '/proyectos/bioconstruccion', label: 'Bioconstrucción' },
  ],
  participa: [
    { href: '#inscribete', label: 'Inducción' },
    { href: '/donar', label: 'Donar' },
    { href: '/voluntariado', label: 'Voluntariado' },
  ],
};
---

<footer class="bg-carbon py-12 text-white/80">
  <div class="container-narrow mb-10 grid gap-8 text-sm md:grid-cols-4">
    <div>
      <p class="mb-3 font-display text-2xl font-bold text-white">
        AMEEC<span class="text-ocre-400">.</span>
      </p>
      <p class="leading-relaxed text-white/70">
        Educación ecológica y bioconstrucción comunitaria desde México.
      </p>
    </div>

    <div>
      <h4 class="mb-3 font-semibold text-white">Ecosistema</h4>
      <ul class="space-y-2">
        {
          links.ecosistema.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-ocre-400">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="mb-3 font-semibold text-white">Participa</h4>
      <ul class="space-y-2">
        {
          links.participa.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-ocre-400">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="mb-3 font-semibold text-white">Contacto</h4>
      <p class="text-white/70">{general.contact_email}</p>
      <p class="mt-2 text-white/70">{general.location}</p>
    </div>
  </div>

  <div class="border-t border-white/10 pt-8 text-center text-xs text-white/40">
    <p>© 2026 AMEEC · Hecho con tierra, código y cuidado.</p>
  </div>
</footer>
