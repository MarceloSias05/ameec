---
const nav = [
  { href: '#proceso', label: 'El proceso' },
  { href: '#impacto', label: 'Impacto' },
  { href: '#historias', label: 'Historias' },
  { href: '#faq', label: 'Preguntas' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full transition-all duration-300"
  data-transparent="true"
>
<div class="container-narrow relative flex items-center justify-between py-5">
  <a href="/" class="font-display text-2xl font-bold text-verde-500" aria-label="AMEEC — Inicio">
    AMEEC<span class="text-ocre-400">.</span>
  </a>

  <div class="hidden items-center gap-8 md:flex">
    <nav class="flex gap-8 text-sm font-medium" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a href={item.href} class="text-carbon/80 transition-colors hover:text-ocre-400">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#inscribete"
      class="rounded-full bg-verde-500 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-ocre-400"
    >
      Inscribirme
    </a>
  </div>

  <button
    type="button"
    class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-carbon/10 bg-white text-verde-500 shadow-sm md:hidden"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-menu-toggle
  >
    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path
        d="M3 6h14M3 10h14M3 14h14"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <div
    id="mobile-menu"
    class="absolute left-6 right-6 top-full hidden rounded-3xl border border-carbon/10 bg-white p-4 shadow-xl md:hidden"
    data-mobile-menu
  >
    <nav class="grid gap-1 text-sm font-medium" aria-label="Navegación móvil">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-2xl px-4 py-3 text-carbon/80 transition-colors hover:bg-crema hover:text-ocre-400"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="#inscribete"
        class="mt-2 rounded-full bg-verde-500 px-5 py-3 text-center text-white transition-colors hover:bg-ocre-400"
      >
        Inscribirme
      </a>
    </nav>
  </div>
</div>
</header>

<script>
  // Sticky header: transparente sobre hero fullscreen, sólido al hacer scroll
  const header = document.getElementById('site-header');
  if (header) {
    const isTransparent = header.dataset.transparent === 'true';

    const onScroll = () => {
      const pastHero = window.scrollY > window.innerHeight * 0.6;

      if (pastHero || !isTransparent) {
        header.classList.add('bg-crema/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-carbon/5');
        header.classList.remove('text-white');
        logo.classList.remove('text-white');
        logo.classList.add('text-verde-500');
        navLinks.forEach(l => { l.classList.remove('text-white/80'); l.classList.add('text-carbon/80'); });
        ctaBtn.classList.remove('bg-white', 'text-carbon');
        ctaBtn.classList.add('bg-verde-500', 'text-white');
        menuBtn?.classList.remove('border-white/30', 'text-white');
        menuBtn?.classList.add('border-carbon/10', 'text-verde-500', 'bg-white');
      } else {
        header.classList.remove('bg-crema/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-carbon/5');
        logo.classList.add('text-white');
        logo.classList.remove('text-verde-500');
        navLinks.forEach(l => { l.classList.add('text-white/80'); l.classList.remove('text-carbon/80'); });
        ctaBtn.classList.add('bg-white', 'text-carbon');
        ctaBtn.classList.remove('bg-verde-500', 'text-white');
        menuBtn?.classList.add('border-white/30', 'text-white');
        menuBtn?.classList.remove('border-carbon/10', 'text-verde-500', 'bg-white');
      }
    };

    const logo = header.querySelector('a[aria-label]') as HTMLElement;
    const navLinks = header.querySelectorAll('nav a');
    const ctaBtn = header.querySelector('a[href="#inscribete"]') as HTMLElement;
    const menuBtn = header.querySelector('[data-menu-toggle]') as HTMLElement;

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  const menuButton = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');

  if (menuButton && mobileMenu) {
    const closeMenu = () => {
      menuButton.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.add('hidden');
    };

    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';

      menuButton.setAttribute('aria-expanded', String(!isOpen));
      mobileMenu.classList.toggle('hidden', isOpen);
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }
</script>
