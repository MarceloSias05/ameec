---
import { Image } from 'astro:assets';
import general from '../content/config/general.json';
import heroWorkshop from '../assets/hero-workshop.svg';

const { hero } = general;
---

<section
  class="container-narrow grid items-center gap-12 pb-24 pt-12 md:grid-cols-2 md:pb-32 md:pt-20"
>
  <div>
    <p class="eyebrow mb-4">{hero.eyebrow}</p>
    <h1 class="mb-6 font-display text-5xl font-bold leading-tight text-verde-500 md:text-6xl">
      {hero.title}
      <span class="italic text-ocre-400">{hero.title_accent}</span>.
    </h1>
    <p class="mb-8 text-lg leading-relaxed text-carbon/80 md:text-xl">
      {hero.body}
    </p>
    <div class="flex flex-col gap-4 sm:flex-row">
      <a href="#inscribete" class="btn-primary"> {hero.primary_cta} </a>
      <a href="#proceso" class="btn-secondary"> {hero.secondary_cta} </a>
    </div>
  </div>

  <div class="relative">
    <div class="relative aspect-square overflow-hidden rounded-3xl bg-verde-500 shadow-lg">
      <Image
        src={heroWorkshop}
        alt={hero.image_alt}
        class="h-full w-full object-cover"
        loading="eager"
      />
      <div
        class="absolute inset-0 flex items-end bg-gradient-to-t from-black/40 to-transparent p-6"
      >
        <div class="text-white">
          <p class="font-display text-2xl font-semibold leading-snug">
            "{hero.quote}"
          </p>
          <p class="mt-3 text-sm opacity-80">— {hero.quote_author}</p>
        </div>
      </div>
    </div>
  </div>
</section>
