---
import impactData from '../content/induccion/impact.json';

const metrics = impactData.items;
---

<section id="impacto" class="bg-verde-500 py-20 text-white md:py-24">
  <div class="container-narrow">
    <div class="grid gap-10 md:grid-cols-[1fr_1.4fr] md:items-end">
      <div>
        <p class="eyebrow mb-3 text-ocre-200">Impacto</p>
        <h2 class="font-display text-4xl font-bold leading-tight md:text-5xl">
          Números para contar una historia colectiva
        </h2>
        <p class="mt-5 leading-relaxed text-white/75">
          Estos datos están marcados como pendientes para evitar publicar cifras no verificadas.
        </p>
      </div>

      <dl class="grid gap-4 sm:grid-cols-3">
        {
          metrics.map((metric) => (
            <div class="rounded-3xl border border-white/15 bg-white/10 p-6 backdrop-blur">
              <dt class="text-sm font-medium uppercase tracking-wider text-white/65">
                {metric.label}
              </dt>
              <dd class="mt-4 font-display text-6xl font-bold text-ocre-200">{metric.value}</dd>
              <p class="mt-4 text-xs leading-relaxed text-white/60">{metric.note}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
