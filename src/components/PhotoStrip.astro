---
import { Image } from 'astro:assets';
import bioconstruccion from '../assets/ameec-bioconstruccion.jpg';
import comunidad from '../assets/ameec-comunidad.jpg';
import olas from '../assets/ameec-olas.jpg';

const photos = [
  {
    src: comunidad,
    alt: 'Comunidad participando en un proyecto de AMEEC',
    caption: 'Trabajo comunitario',
  },
  {
    src: bioconstruccion,
    alt: 'Proceso de bioconstrucción con cáñamo',
    caption: 'Bioconstrucción',
  },
  {
    src: olas,
    alt: 'Niños disfrutando del mar en el proyecto Olas de Amor',
    caption: 'Olas de Amor',
  },
];
---

<section class="bg-crema py-16 md:py-20" aria-label="Galería de proyectos AMEEC">
  <div class="container-narrow">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow mb-3">Desde el territorio</p>
        <h2 class="font-display text-3xl font-bold leading-tight text-verde-500 md:text-4xl">
          Imágenes reales de los proyectos actuales
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-carbon/65">
        Fotografías tomadas del sitio institucional actual para reemplazar placeholders antes de la
        validación visual.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {
        photos.map((photo) => (
          <figure class="group overflow-hidden rounded-3xl bg-white shadow-sm">
            <Image
              src={photo.src}
              alt={photo.alt}
              width={700}
              height={520}
              class="h-72 w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <figcaption class="px-5 py-4 text-sm font-medium text-verde-500">
              {photo.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
