---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import HeroFullscreen from '@components/HeroFullscreen.astro';
import BienvenidaServicio from '@components/BienvenidaServicio.astro';
import SiguientesPasos from '@components/SiguientesPasos.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import ImpactNumbers from '@components/ImpactNumbers.astro';
import PhotoStrip from '@components/PhotoStrip.astro';
import Stories from '@components/Stories.astro';
import FAQ from '@components/FAQ.astro';
import FormularioInscripcion from '@components/FormularioInscripcion.astro';
import Footer from '@components/Footer.astro';
---

<Layout
  title="Inducción AMEEC — Empieza tu camino con nosotros"
  description="Bienvenido al proceso de inducción de la Asociación Mexicana de Educación Ecológica y Comunitaria. Guía completa de acceso, módulos y material de apoyo."
>
  <!-- El header se superpone sobre el hero fullscreen -->
  <div class="absolute top-0 left-0 right-0 z-50 w-full">
    <Header />
  </div>

  <main id="main">
    <HeroFullscreen />
    <BienvenidaServicio />
    <SiguientesPasos />
    <ProcessSteps />
    <ImpactNumbers />
    <PhotoStrip />
    <Stories />
    <FAQ />
    <FormularioInscripcion />
  </main>
  <Footer />
</Layout>
