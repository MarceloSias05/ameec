---
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import olasPhoto from '../../assets/ameec-olas.jpg';

const actividades = [
  { titulo: 'Exploración costera', desc: 'Recorridos guiados por la franja litoral para conocer ecosistemas de manglar, arrecife y playa.' },
  { titulo: 'Arte con materiales naturales', desc: 'Talleres de expresión con elementos recolectados del entorno: conchas, arena, semillas y algas.' },
  { titulo: 'Cuentacuentos ecológicos', desc: 'Sesiones de narración oral sobre la relación entre las comunidades y el mar, con participación de personas mayores.' },
  { titulo: 'Siembra de conciencia', desc: 'Actividades de limpieza de playa y germinación de plantas nativas para que la infancia experimente el ciclo natural.' },
];

const impacto = [
  { valor: '120+', etiqueta: 'niñas y niños participantes', nota: 'Dato orientativo — confirmar con AMEEC' },
  { valor: '6', etiqueta: 'comunidades costeras', nota: 'Dato orientativo — confirmar con AMEEC' },
  { valor: '3', etiqueta: 'estados de México', nota: 'Dato orientativo — confirmar con AMEEC' },
];
---

<Layout
  title="Olas de Amor — AMEEC"
  description="Proyecto de educación ambiental con infancia en comunidades costeras de México. Juego, naturaleza y cuidado comunitario desde la primera infancia."
>
  <Header />
  <main id="main">

    <!-- Hero -->
    <section class="container-narrow grid items-center gap-12 pb-24 pt-12 md:grid-cols-2 md:pb-32 md:pt-20">
      <div>
        <p class="eyebrow mb-4">Proyecto AMEEC</p>
        <h1 class="mb-6 font-display text-5xl font-bold leading-tight text-verde-500 md:text-6xl">
          Olas de <span class="italic text-ocre-400">Amor</span>
        </h1>
        <p class="mb-8 text-lg leading-relaxed text-carbon/80 md:text-xl">
          Educación ambiental con infancia en comunidades costeras. Combinamos juego, naturaleza y cuidado comunitario para sembrar el vínculo con el entorno desde la primera infancia.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a href="/#inscribete" class="btn-primary">Participar en este proyecto</a>
          <a href="/#proceso" class="btn-secondary">Conocer la inducción</a>
        </div>
      </div>

      <div class="relative">
        <div class="aspect-square overflow-hidden rounded-3xl shadow-lg">
          <Image
            src={olasPhoto}
            alt="Niños y niñas participando en actividades de Olas de Amor en una playa mexicana"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-4 -left-4 hidden rounded-2xl bg-ocre-400 px-5 py-4 text-white shadow-lg md:block">
          <p class="font-display text-3xl font-bold">+120</p>
          <p class="text-sm opacity-90">niñas y niños alcanzados</p>
        </div>
      </div>
    </section>

    <!-- Actividades -->
    <section class="bg-white py-20 md:py-24">
      <div class="container-narrow">
        <div class="mb-14 max-w-2xl">
          <p class="eyebrow mb-3">Lo que hacemos</p>
          <h2 class="font-display text-4xl font-bold leading-tight text-verde-500 md:text-5xl">
            Actividades del proyecto
          </h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {actividades.map((act, i) => (
            <div
              data-reveal
              data-reveal-delay={String(i * 100)}
              class="rounded-2xl border border-carbon/8 bg-crema p-7 hover:shadow-md transition-shadow"
            >
              <div class="mb-4 h-1 w-10 rounded-full bg-ocre-400"></div>
              <h3 class="mb-2 font-display text-xl font-semibold text-verde-500">{act.titulo}</h3>
              <p class="text-sm leading-relaxed text-carbon/70">{act.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Impacto -->
    <section class="bg-verde-500 py-16 md:py-20 text-white">
      <div class="container-narrow">
        <p class="eyebrow mb-10 text-ocre-200">Impacto acumulado</p>
        <div class="grid gap-6 sm:grid-cols-3">
          {impacto.map((item, i) => (
            <div data-reveal data-reveal-delay={String(i * 100)} class="rounded-3xl border border-white/15 bg-white/10 p-6 backdrop-blur">
              <p class="font-display text-5xl font-bold text-ocre-200">{item.valor}</p>
              <p class="mt-3 font-medium">{item.etiqueta}</p>
              <p class="mt-2 text-xs text-white/50 italic">{item.nota}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 md:py-28">
      <div class="container-narrow max-w-3xl text-center mx-auto">
        <p class="eyebrow mb-4">¿Te suma este proyecto?</p>
        <h2 class="font-display text-4xl font-bold text-verde-500 mb-6">
          El primer paso es conocernos
        </h2>
        <p class="text-lg text-carbon/70 leading-relaxed mb-10">
          Para unirte a Olas de Amor, el camino empieza en la inducción general de AMEEC. Ahí conoces todos los proyectos activos y eliges dónde quieres contribuir.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#inscribete" class="btn-primary">Inscribirme a la inducción</a>
          <a href="mailto:hola@ameec.org?subject=Quiero saber más de Olas de Amor" class="btn-secondary">
            Preguntar por correo
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
