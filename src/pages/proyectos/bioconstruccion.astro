---
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import bioPhoto from '../../assets/ameec-bioconstruccion.jpg';

const materiales = [
  { nombre: 'Adobe', desc: 'Mezcla de tierra arcillosa, fibra vegetal y agua. Excelente aislante térmico y acústico.' },
  { nombre: 'Cáñamo', desc: 'Fibra de cannabis industrial mezclada con cal (hempcrete). Alta resistencia y carbono negativo.' },
  { nombre: 'Bambú', desc: 'Estructura ligera de alta resistencia. Ideal para techos, pisos y elementos decorativos.' },
  { nombre: 'Tierra comprimida', desc: 'Bloques prensados sin cocción. Bajo consumo energético y materiales locales.' },
];

const talleres = [
  { nombre: 'Introducción a la bioconstrucción', duracion: '2 días', nivel: 'Principiante', costo: 'Cuota simbólica' },
  { nombre: 'Construcción con adobe', duracion: '5 días', nivel: 'Intermedio', costo: 'Cuota simbólica' },
  { nombre: 'Hempcrete y cáñamo', duracion: '3 días', nivel: 'Intermedio', costo: 'Cuota simbólica' },
  { nombre: 'Diseño bioclimático', duracion: '4 días', nivel: 'Avanzado', costo: 'Cuota simbólica' },
];
---

<Layout
  title="Bioconstrucción — AMEEC"
  description="Talleres prácticos de construcción con materiales naturales: adobe, cáñamo, bambú y tierra comprimida en distintos estados de México."
>
  <Header />
  <main id="main">

    <!-- Hero -->
    <section class="container-narrow grid items-center gap-12 pb-24 pt-12 md:grid-cols-2 md:pb-32 md:pt-20">
      <div>
        <p class="eyebrow mb-4">Proyecto AMEEC</p>
        <h1 class="mb-6 font-display text-5xl font-bold leading-tight text-verde-500 md:text-6xl">
          Bio<span class="italic text-ocre-400">construcción</span>
        </h1>
        <p class="mb-8 text-lg leading-relaxed text-carbon/80 md:text-xl">
          Talleres prácticos de construcción con materiales naturales. Técnica ancestral, diseño contemporáneo, impacto real en comunidades de todo México.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a href="/#inscribete" class="btn-primary">Quiero participar</a>
          <a href="#talleres" class="btn-secondary">Ver talleres</a>
        </div>
      </div>

      <div class="relative">
        <div class="aspect-square overflow-hidden rounded-3xl shadow-lg">
          <Image
            src={bioPhoto}
            alt="Participantes trabajando con materiales naturales en un taller de bioconstrucción de AMEEC"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-4 -right-4 hidden rounded-2xl bg-verde-500 px-5 py-4 text-white shadow-lg md:block">
          <p class="font-display text-3xl font-bold">100%</p>
          <p class="text-sm opacity-90">materiales naturales</p>
        </div>
      </div>
    </section>

    <!-- Materiales -->
    <section class="bg-white py-20 md:py-24">
      <div class="container-narrow">
        <div class="mb-14 max-w-2xl">
          <p class="eyebrow mb-3">Con qué construimos</p>
          <h2 class="font-display text-4xl font-bold leading-tight text-verde-500 md:text-5xl">
            Materiales que vienen de la tierra
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {materiales.map((mat, i) => (
            <div
              data-reveal
              data-reveal-delay={String(i * 100)}
              class="rounded-2xl border-t-4 border-ocre-400 bg-crema p-6 hover:shadow-md transition-shadow"
            >
              <h3 class="mb-2 font-display text-xl font-semibold text-verde-500">{mat.nombre}</h3>
              <p class="text-sm leading-relaxed text-carbon/70">{mat.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Talleres -->
    <section id="talleres" class="py-20 md:py-24">
      <div class="container-narrow">
        <div class="mb-14 max-w-2xl">
          <p class="eyebrow mb-3">Formación</p>
          <h2 class="font-display text-4xl font-bold leading-tight text-verde-500 md:text-5xl">
            Talleres activos
          </h2>
          <p class="mt-4 text-carbon/65 text-sm leading-relaxed">
            Fechas y ubicaciones se coordinan con cada grupo. Escríbenos para el próximo calendario.
          </p>
        </div>
        <div class="max-w-3xl space-y-4">
          {talleres.map((taller, i) => (
            <div
              data-reveal
              data-reveal-delay={String(i * 80)}
              class="flex flex-col gap-4 rounded-2xl bg-white p-6 shadow-sm border border-carbon/5 md:flex-row md:items-center md:justify-between"
            >
              <div>
                <p class="font-semibold text-carbon">{taller.nombre}</p>
                <p class="text-sm text-carbon/55 mt-1">{taller.nivel} · {taller.duracion}</p>
              </div>
              <div class="flex items-center gap-4">
                <span class="text-sm text-ocre-400 font-medium">{taller.costo}</span>
                <a
                  href={`mailto:hola@ameec.org?subject=Info taller: ${taller.nombre}`}
                  class="rounded-full bg-verde-500 px-5 py-2 text-sm font-medium text-white hover:bg-ocre-400 transition-colors whitespace-nowrap"
                >
                  Más info
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-verde-500 py-20 md:py-24 text-white">
      <div class="container-narrow max-w-3xl mx-auto text-center">
        <h2 class="font-display text-4xl font-bold mb-6">
          ¿Listo para poner las manos en la tierra?
        </h2>
        <p class="text-white/80 leading-relaxed mb-10 text-lg">
          El acceso a los talleres de bioconstrucción se coordina a través del proceso de inducción de AMEEC. Un paso sencillo abre todas las puertas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#inscribete" class="bg-white text-verde-500 px-7 py-3.5 rounded-full font-medium hover:bg-crema transition-colors">
            Iniciar inducción
          </a>
          <a href="mailto:hola@ameec.org?subject=Quiero unirme a Bioconstrucción AMEEC" class="border-2 border-white/40 text-white px-7 py-3.5 rounded-full font-medium hover:border-white transition-colors">
            Escribirnos
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
