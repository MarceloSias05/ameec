---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

const temas = [
  {
    num: '01',
    titulo: '¿Qué es AMEEC?',
    desc: 'Historia, misión, visión y valores de la Asociación Mexicana de Educación Ecológica y Comunitaria. Conoce quiénes somos y hacia dónde vamos.',
    recurso: null,
  },
  {
    num: '02',
    titulo: 'Legalidad',
    desc: 'Marco legal de tu participación como prestador/a de servicio social. Convenios institucionales, carta de asignación y documentación requerida.',
    recurso: null,
  },
  {
    num: '03',
    titulo: 'Responsabilidad Social',
    desc: 'Compromisos éticos y comunitarios que asumes al integrarte a AMEEC. Código de conducta, confidencialidad y cuidado colectivo.',
    recurso: null,
  },
  {
    num: '04',
    titulo: 'Investigación',
    desc: 'Líneas de investigación activas en AMEEC. Cómo tu trabajo puede contribuir al conocimiento sobre educación ecológica y bioconstrucción.',
    recurso: null,
  },
];
---

<Layout
  title="Módulo Inducción — AMEEC"
  description="Guía de inducción al Servicio Social en AMEEC: misión, legalidad, responsabilidad social e investigación."
>
  <Header />
  <main id="main">
    <section class="bg-verde-500 py-16 text-white">
      <div class="container-narrow">
        <a href="/#pasos" class="mb-6 inline-flex items-center gap-2 text-sm text-white/70 hover:text-white transition-colors">
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"/></svg>
          Volver a los módulos
        </a>
        <p class="eyebrow mb-3 text-ocre-200">Módulo 1</p>
        <h1 class="font-display text-5xl font-bold md:text-6xl">Inducción</h1>
        <p class="mt-4 max-w-xl text-white/80 leading-relaxed">Todo lo que necesitas saber para entender dónde estás, qué puedes hacer y cómo tu participación impacta a la comunidad.</p>
      </div>
    </section>

    <section class="container-narrow py-16 md:py-20">
      <div class="grid gap-6 md:grid-cols-2">
        {temas.map((tema) => (
          <div data-reveal class="rounded-2xl border border-carbon/8 bg-white p-8 shadow-sm hover:shadow-md transition-shadow">
            <span class="font-display text-4xl font-bold text-ocre-400">{tema.num}</span>
            <h2 class="mt-4 mb-3 font-display text-2xl font-semibold text-verde-500">{tema.titulo}</h2>
            <p class="text-sm leading-relaxed text-carbon/70">{tema.desc}</p>
            {tema.recurso && (
              <a href={tema.recurso} class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-verde-500 hover:text-ocre-400 transition-colors">
                Ver recurso →
              </a>
            )}
            {!tema.recurso && (
              <p class="mt-4 text-xs text-carbon/40 italic">Contenido próximamente — consulta con tu coordinador/a</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="bg-crema py-12">
      <div class="container-narrow flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:text-left">
        <div>
          <p class="font-semibold text-carbon">¿Tienes dudas sobre este módulo?</p>
          <p class="text-sm text-carbon/60">Tu coordinador/a puede orientarte o escríbenos directamente.</p>
        </div>
        <a href="mailto:hola@ameec.org?subject=Duda módulo Inducción" class="btn-primary whitespace-nowrap">
          Preguntar por correo
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
