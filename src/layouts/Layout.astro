---
import '../styles/global.css';
import Chatbot from '@components/Chatbot.astro';
import ScrollReveal from '@components/ScrollReveal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Inducción AMEEC — Bienvenido/a al Servicio Social',
  description = 'Bienvenido/a a la Asociación Mexicana de Empresarios y Ejidos Cannábicos A.C. Conoce el proceso de inducción y empieza tu camino.',
  image = '/og-image.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2F5F2F" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {import.meta.env.PROD && (
      <script defer data-domain="induccion.ameec.org" src="https://plausible.io/js/script.js" />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-verde-500 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido principal
    </a>

    <slot />
    <Chatbot />
    <ScrollReveal />
  </body>
</html>
